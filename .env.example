# NOEMA defaults to Kalshi demo.
NOEMA_KALSHI_ENV=demo

# Optional authenticated demo/production API access.
# Never commit the key file itself.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=

# Production execution remains disabled unless this is explicitly set to 1.
NOEMA_ALLOW_LIVE_ORDERS=0

# Emergency hard stop. 1 disables all production execution even if live mode is armed.
NOEMA_MASTER_HALT=0


# Persistent NOEMA agent runtime.
NOEMA_AGENT_CYCLE_SECONDS=30
NOEMA_AGENT_HEARTBEAT_SECONDS=15
NOEMA_AGENT_RADAR_LIMIT=50
NOEMA_AGENT_MAX_MARKETS_PER_CYCLE=100

# Dedicated EVM agent wallet observation.
# This is the public address + RPC endpoint only. Do not put a private key here.
NOEMA_EVM_RPC_URL=
NOEMA_EVM_ADDRESS=

# Microsoft Foundry cognition (Azure OpenAI v1 Responses API).
# Endpoint example: https://YOUR-RESOURCE.openai.azure.com
# Deployment is your deployment name, not necessarily the catalog model ID.
NOEMA_FOUNDRY_ENDPOINT=
NOEMA_FOUNDRY_DEPLOYMENT=
NOEMA_FOUNDRY_API_KEY=
NOEMA_FOUNDRY_REASONING_EFFORT=medium
NOEMA_FOUNDRY_TIMEOUT_SECONDS=60

# Selective cognition policy.
NOEMA_COGNITION_ENABLED=1
NOEMA_COGNITION_MIN_ATTENTION=0.70
NOEMA_COGNITION_MIN_ROBUST_EDGE=0.01
NOEMA_COGNITION_MAX_FRESHNESS_SECONDS=120
NOEMA_COGNITION_MAX_UNCERTAINTY=0.20
NOEMA_COGNITION_COOLDOWN_SECONDS=300
NOEMA_COGNITION_MAX_CALLS_PER_HOUR=6
