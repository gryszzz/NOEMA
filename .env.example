# NOEMA defaults to Kalshi demo.
NOEMA_KALSHI_ENV=demo

# Optional authenticated demo/production API access.
# Never commit the key file itself.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=

# Production execution remains disabled unless this is explicitly set to 1.
NOEMA_ALLOW_LIVE_ORDERS=0

# Emergency hard stop. 1 disables all production execution even if live mode is armed.
NOEMA_MASTER_HALT=0
