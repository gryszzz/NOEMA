# NOEMA defaults to Kalshi demo.
NOEMA_KALSHI_ENV=demo

# Optional authenticated demo/production API access.
# Never commit the key file itself.
KALSHI_API_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
# If unset, NOEMA reads the Kalshi Key ID from macOS Keychain service
# com.noema.kalshi.key-id (account noema-owner) and uses the standard protected
# PEM path ~/.config/noema/credentials/kalshi.pem when present.

# Polymarket US public market research uses the official polymarket-us SDK.
# Trading credentials are separate Keychain entries; never add them here.
NOEMA_POLYMARKET_US_ENABLED=

# Production execution remains disabled unless this is explicitly set to 1.
NOEMA_ALLOW_LIVE_ORDERS=0

# Emergency hard stop. 1 disables all production execution even if live mode is armed.
NOEMA_MASTER_HALT=0


# Persistent NOEMA agent runtime.
NOEMA_AGENT_CYCLE_SECONDS=30
NOEMA_AGENT_HEARTBEAT_SECONDS=15
NOEMA_AGENT_RADAR_LIMIT=50
NOEMA_AGENT_MAX_MARKETS_PER_CYCLE=100

# Dedicated EVM agent wallet observation.
# This is the public address + RPC endpoint only. Do not put a private key here.
NOEMA_EVM_RPC_URL=
NOEMA_EVM_ADDRESS=
NOEMA_EVM_RPC_URL_ETHEREUM=
NOEMA_EVM_RPC_URL_BASE=
NOEMA_EVM_RPC_URL_POLYGON=
NOEMA_EVM_TOKEN_INDEXER_URL_BASE=
NOEMA_EVM_SIGNER_ENABLED=0
NOEMA_EVM_MASTER_HALT=1
NOEMA_WALLET_MASTER_HALT=1

# Dedicated Solana and Bitcoin identities are public addresses only. Private
# credentials belong in the matching owner-only macOS Keychain items.
NOEMA_SOLANA_WALLET_ADDRESS=
NOEMA_SOLANA_RPC_URL=
# Optional read-only RPC failover for Trench holder enrichment; never used for signing.
NOEMA_SOLANA_RPC_FALLBACK_URL=
NOEMA_SOLANA_SIGNER_ENABLED=0
NOEMA_SOLANA_MASTER_HALT=1
NOEMA_BITCOIN_ADDRESS=
NOEMA_BITCOIN_ESPLORA_URL=
NOEMA_BITCOIN_SIGNER_ENABLED=0
NOEMA_BITCOIN_MASTER_HALT=1

# Microsoft Foundry cognition (Azure OpenAI v1 Responses API).
# Endpoint example: https://YOUR-RESOURCE.openai.azure.com
# Deployment is your deployment name, not necessarily the catalog model ID.
NOEMA_FOUNDRY_ENDPOINT=
NOEMA_FOUNDRY_DEPLOYMENT=
NOEMA_FOUNDRY_API_KEY=
NOEMA_FOUNDRY_REASONING_EFFORT=medium
NOEMA_FOUNDRY_TIMEOUT_SECONDS=60
NOEMA_FOUNDRY_MAX_OUTPUT_TOKENS=1500

# Official OpenAI Responses API cognition. Inject OPENAI_API_KEY into the NOEMA
# runtime secret environment; never place the secret in this file or source control.
# Cloud cognition stays disabled until an owner model budget is recorded in NOEMA.
NOEMA_COGNITION_PROVIDER=auto
NOEMA_OPENAI_ENABLED=0
NOEMA_OPENAI_MODEL=gpt-4.1-mini
NOEMA_OPENAI_PRICING_MODEL=gpt-4.1-mini
NOEMA_OPENAI_INPUT_USD_PER_MILLION=0.40
NOEMA_OPENAI_OUTPUT_USD_PER_MILLION=1.60
NOEMA_OPENAI_MAX_OUTPUT_TOKENS=1500
NOEMA_OPENAI_TIMEOUT_SECONDS=60
NOEMA_OPENAI_TRACING=1
# Optional; omit unless the owner's project scope requires it.
# NOEMA_OPENAI_PROJECT_ID=

# Cloudflare Workers AI uses the account-scoped REST API. Keep both credentials
# in the owner-only runtime environment; never expose them to the workstation UI.
# Model metadata health is read-only. Inference uses the owner model-budget gate.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
NOEMA_CLOUDFLARE_ENABLED=1
NOEMA_CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
NOEMA_CLOUDFLARE_PRICING_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast
NOEMA_CLOUDFLARE_INPUT_USD_PER_MILLION=0.293
NOEMA_CLOUDFLARE_OUTPUT_USD_PER_MILLION=2.253
NOEMA_CLOUDFLARE_MAX_OUTPUT_TOKENS=1500
NOEMA_CLOUDFLARE_TIMEOUT_SECONDS=60

# Locally hosted specialists; loopback endpoints are read-only inference services.
NOEMA_LOCAL_COGNITION_ENABLED=1
NOEMA_LOCAL_ENDPOINT=http://127.0.0.1:12434/engines/v1
NOEMA_LOCAL_MODEL=docker.io/ai/gemma3:latest
NOEMA_CHRONOS_URL=http://127.0.0.1:8011
NOEMA_FINBERT_URL=http://127.0.0.1:8012

# Heavy workloads use one process-wide slot each and run only on demand.
# Docker Desktop is started only when an admitted OpenClaw task needs it. NOEMA
# stops Docker Desktop afterward only if NOEMA started it and no other containers
# are running. Worker sandbox policy remains enforced by OpenClaw.
NOEMA_DOCKER_DESKTOP_AUTOSTART=1
NOEMA_MIN_AVAILABLE_MEMORY_PERCENT=20
# Optional path for process-shared resource locks; the default is data/runtime-locks.
# NOEMA_RESOURCE_LOCK_DIR=

# OpenClaw is provisioned only for admitted work. These optional Compose files
# let NOEMA recover a missing Gateway container without embedding host paths.
# Separate multiple files with commas. Directory and project name are derived
# from the first file unless explicitly set. Never put credentials here.
NOEMA_OPENCLAW_ENABLED=0
NOEMA_OPENCLAW_AGENT_ID=noema-research
NOEMA_OPENCLAW_TIMEOUT_SECONDS=120
NOEMA_OPENCLAW_COMPOSE_FILES=
NOEMA_OPENCLAW_COMPOSE_PROJECT_DIRECTORY=
NOEMA_OPENCLAW_COMPOSE_PROJECT_NAME=

# Registered experiments run in a bounded, credential-free local subprocess.
# Provider cost/token reservations remain the cognition-spend authority.
NOEMA_RESEARCH_WORK_ENABLED=0
NOEMA_RESEARCH_MAX_RUNS_PER_DAY=4
NOEMA_RESEARCH_TIMEOUT_SECONDS=30
NOEMA_RESEARCH_MAX_ROWS_PER_TABLE=20000
NOEMA_RESEARCH_SESSION_COOLDOWN_SECONDS=300
# Optional Stripe read-only refresh interval (seconds): NOEMA_STRIPE_SYNC_INTERVAL_SECONDS

# Selective cognition policy.
NOEMA_COGNITION_ENABLED=1
NOEMA_COGNITION_MIN_ATTENTION=0.70
NOEMA_COGNITION_MIN_ROBUST_EDGE=0.01
NOEMA_COGNITION_MAX_FRESHNESS_SECONDS=120
NOEMA_COGNITION_MAX_UNCERTAINTY=0.20
NOEMA_COGNITION_COOLDOWN_SECONDS=300
NOEMA_COGNITION_MAX_CALLS_PER_HOUR=6
NOEMA_COGNITION_MAX_TOKENS_PER_HOUR=20000


# Trench-1 Solana research feeds (read-only).
# Jupiter recommends an API key; leave blank for environments/endpoints that allow keyless access.
NOEMA_JUPITER_API_KEY=
NOEMA_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com


# Trench-1 continuous Solana launch research.
# Off by default. This is read-only collection; it never submits a swap.
NOEMA_TRENCH_ENABLED=0
NOEMA_TRENCH_DUE_LIMIT=12
NOEMA_TRENCH_ENRICHMENT_LIMIT=1
# Conservative for Jupiter keyless 0.5 RPS. Lower only if your API tier allows it.
NOEMA_TRENCH_REQUEST_PAUSE_SECONDS=2.1
