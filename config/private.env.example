# Copy to /workspace/noema-run/private.env (outside the repo, chmod 600). Never commit the real file.
NOEMA_SOLANA_WALLET_ADDRESS=<YOUR_SOLANA_ADDRESS>
NOEMA_EVM_ADDRESS=<YOUR_EVM_ADDRESS>
NOEMA_SOLANA_SIGNER_PIN=<YOUR_SOLANA_ADDRESS>
NOEMA_EVM_SIGNER_PIN=<YOUR_EVM_ADDRESS>
NOEMA_PUMPPORTAL_WALLET_ADDRESS=<PUMPPORTAL_KEY_WALLET_PUBLIC_ADDRESS>
NOEMA_PUMPPORTAL_WARN_SOL=0.025
NOEMA_TREASURY_BONUSES=
# Tuned strategy thresholds / edge params (override code defaults)
NOEMA_ENTRY_BUFFER=
NOEMA_CAPITAL_FLOOR_FRACTION=
NOEMA_DAILY_LOSS_STOP_FRACTION=
# Smart-wallet seed list (comma separated) and private hostnames
NOEMA_SMART_WALLET_SEEDS=
NOEMA_TEV_URL=https://<your-machine>.<your-tailnet>.ts.net/trading-room
